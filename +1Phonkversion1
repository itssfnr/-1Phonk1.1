local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

-- Clipboard in Roblox Studio is not available to normal LocalScripts.
-- This fallback displays selectable text for manual copying.
local function showCopyText(textToCopy)
    local old = gui:FindFirstChild("CopyWindow")
    if old then old:Destroy() end

    local popup = Instance.new("Frame")
    popup.Name = "CopyWindow"
    popup.Size = UDim2.fromOffset(420, 210)
    popup.Position = UDim2.new(0.5, -210, 0.5, -105)
    popup.BackgroundColor3 = Color3.fromRGB(38, 40, 52)
    popup.ZIndex = 5
    popup.Parent = gui
    Instance.new("UICorner", popup)

    local heading = Instance.new("TextLabel")
    heading.Size = UDim2.new(1, -50, 0, 35)
    heading.Position = UDim2.fromOffset(10, 5)
    heading.BackgroundTransparency = 1
    heading.Text = "Copy position data"
    heading.TextColor3 = Color3.new(1, 1, 1)
    heading.Font = Enum.Font.GothamBold
    heading.TextSize = 16
    heading.ZIndex = 6
    heading.Parent = popup

    local exit = Instance.new("TextButton")
    exit.Size = UDim2.fromOffset(30, 30)
    exit.Position = UDim2.new(1, -36, 0, 5)
    exit.Text = "X"
    exit.TextColor3 = Color3.new(1, 1, 1)
    exit.BackgroundColor3 = Color3.fromRGB(180, 55, 60)
    exit.ZIndex = 6
    exit.Parent = popup
    exit.MouseButton1Click:Connect(function()
        popup:Destroy()
    end)

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(1, -20, 1, -55)
    textBox.Position = UDim2.fromOffset(10, 42)
    textBox.BackgroundColor3 = Color3.fromRGB(25, 27, 35)
    textBox.TextColor3 = Color3.new(1, 1, 1)
    textBox.TextSize = 13
    textBox.Font = Enum.Font.Code
    textBox.TextWrapped = false
    textBox.TextXAlignment = Enum.TextXAlignment.Left
    textBox.TextYAlignment = Enum.TextYAlignment.Top
    textBox.ClearTextOnFocus = false
    textBox.MultiLine = true
    textBox.TextEditable = true
    textBox.Text = textToCopy
    textBox.ZIndex = 6
    textBox.Parent = popup

    textBox:CaptureFocus()
    textBox.CursorPosition = 1
    textBox.SelectionStart = 1
    status.Text = "Text markieren und mit STRG+C kopieren"
end

local function makeButton(parent, text, color, x, width)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(width, -4, 0, 34)
    button.Position = UDim2.new(x, 0, 0.5, -17)
    button.Text = text
    button.Font = Enum.Font.GothamBold
    button.TextSize = 11
    button.TextColor3 = Color3.new(1, 1, 1)
    button.BackgroundColor3 = color
    button.Parent = parent
    Instance.new("UICorner", button)
    return button
end

local function refresh()
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    for i = 1, MAX_SLOTS do
        local data = savedPositions[i]

        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -4, 0, 54)
        row.BackgroundColor3 = Color3.fromRGB(44, 47, 60)
        row.BorderSizePixel = 0
        row.LayoutOrder = i
        row.Parent = scroll
        Instance.new("UICorner", row)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.40, -4, 1, -4)
        label.Position = UDim2.fromOffset(7, 2)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextSize = 11
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextWrapped = true

        if data then
            local p = data.position
            label.Text = string.format(
                "%02d. %s\nX: %.3f | Y: %.3f | Z: %.3f",
                i, data.name, p.X, p.Y, p.Z
            )
        else
            label.Text = string.format("%02d. (EMPTY)", i)
            label.TextColor3 = Color3.fromRGB(150, 150, 160)
        end
        label.Parent = row

        local teleport = makeButton(
            row, "GO", Color3.fromRGB(50, 105, 190),
            0.41, 0.17
        )
        teleport.Visible = data ~= nil
        teleport.MouseButton1Click:Connect(function()
            local saved = savedPositions[i]
            local root = getRoot()
            if saved and root then
                root.CFrame = saved.cframe
                status.Text = "Teleported to " .. saved.name
            end
        end)

        local copy = makeButton(
            row, "COPY", Color3.fromRGB(35, 145, 90),
            0.58, 0.19
        )
        copy.Visible = data ~= nil
        copy.MouseButton1Click:Connect(function()
            local saved = savedPositions[i]
            if not saved then return end

            local p = saved.position
            local textToCopy = string.format(
                "Name: %s\nX: %.6f\nY: %.6f\nZ: %.6f\nCFrame: %s",
                saved.name, p.X, p.Y, p.Z, tostring(saved.cframe)
            )
            showCopyText(textToCopy)
        end)

        local delete = makeButton(
            row, "DEL", Color3.fromRGB(175, 55, 60),
            0.77, 0.21
        )
        delete.Visible = data ~= nil
        delete.MouseButton1Click:Connect(function()
            savedPositions[i] = nil
            status.Text = "Slot " .. i .. " deleted"
            refresh()
        end)
    end
end

saveButton.MouseButton1Click:Connect(function()
    local root = getRoot()
    if not root then
        status.Text = "Character not found!"
        return
    end

    local slot
    for i = 1, MAX_SLOTS do
        if not savedPositions[i] then
            slot = i
            break
        end
    end

    if not slot then
        status.Text = "All 50 slots are full!"
        return
    end

    local positionName = nameBox.Text
    if positionName:gsub("%s", "") == "" then
        positionName = "Position " .. slot
    end

    savedPositions[slot] = {
        name = positionName,
        position = root.Position,
        cframe = root.CFrame
    }

    nameBox.Text = ""
    status.Text = "Saved in slot " .. slot
    refresh()
end)

refresh()
